# Price Oracle Configuration
# Copy this to .env and fill in your values

# Stacks Network Configuration
STACKS_NETWORK=testnet
# STACKS_NETWORK=mainnet

# Smart Contract Configuration
RESURRECTION_CONTRACT_ADDRESS=ST2F3J1PK46D6XVRBB9SQ66PY89P8G0EBDW5E05M7

# Contract Owner Private Key (needed to call update-sbtc-price function)
# This should be the private key of the contract owner/admin
ADMIN_PRIVATE_KEY=your_contract_owner_private_key_here

# Server Configuration
PORT=3001

# DIA Oracle API Configuration (optional - uses default public API)
# DIA_API_KEY=your_dia_api_key_if_you_have_one
# DIA_API_BASE_URL=https://api.diadata.org/v1

# Price Update Configuration
PRICE_UPDATE_INTERVAL_MINUTES=5
MAX_PRICE_AGE_MINUTES=10
MIN_PRICE_CHANGE_PERCENT=1

# Logging Configuration
LOG_LEVEL=info
LOG_PRICE_UPDATES=true

# Monitoring Configuration (optional)
# WEBHOOK_URL=https://your-monitoring-service.com/webhook
# ALERT_ON_PRICE_FAILURE=true
# ALERT_ON_CONTRACT_ERROR=true