# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/satoshiquest
MONGODB_URI_TEST=mongodb://localhost:27017/satoshiquest_test
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30000

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Stacks Network Configuration
STACKS_NETWORK=mainnet
STACKS_API_URL=https://api.mainnet.hiro.so
STACKS_WEBSOCKET_URL=wss://api.mainnet.hiro.so

# Contract Addresses (to be updated after deployment)
TOMBSTONE_CONTRACT_ADDRESS=
CORE_CONTRACT_ADDRESS=
LOOT_CONTRACT_ADDRESS=
RESURRECTION_CONTRACT_ADDRESS=

# Chainhook Configuration
CHAINHOOK_ENDPOINT=https://api.chainhook.xyz
CHAINHOOK_API_KEY=your_chainhook_api_key_here
CHAINHOOK_WEBHOOK_SECRET=your_webhook_secret_here

# DIA Oracle Configuration
DIA_ORACLE_URL=https://api.diadata.org
DIA_API_KEY=your_dia_api_key_here

# Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_change_in_production
JWT_EXPIRY=24h
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://satoshiquest.app
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14

# WebSocket Configuration
WS_PING_TIMEOUT=20000
WS_PING_INTERVAL=25000
WS_MAX_CONNECTIONS=1000

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Monitoring & Analytics
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=

# Game Configuration
MAX_TOMBSTONES_PER_CHARACTER=10
RESURRECTION_COOLDOWN_HOURS=24
LEADERBOARD_CACHE_TTL=300
STATS_UPDATE_INTERVAL=60000

# Development Configuration
API_DOCS_ENABLED=true
DEBUG_MODE=false
MOCK_BLOCKCHAIN_EVENTS=false
